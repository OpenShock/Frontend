NODE_PATH=src

PUBLIC_SITE_NAME=OpenShock
PUBLIC_GITHUB_PROJECT_URL=https://github.com/OpenShock
PUBLIC_DISCORD_INVITE_URL=https://discord.gg/OpenShock

PUBLIC_TURNSTILE_DEV_BYPASS_VALUE=INVALID

PUBLIC_DEVELOPMENT_BANNER=false


PUBLIC_DISABLE_SHOCKER_MAP=true

PUBLIC_SITE_URL=https://openshock.app
PUBLIC_SITE_SHORT_URL=https://openshock.app
PUBLIC_BACKEND_API_URL=https://api.openshock.app
PUBLIC_GATEWAY_CSP_WILDCARD=https://*.openshock.app

# security.txt (RFC 9116), served at /.well-known/security.txt. These are the contact details of
# the official OpenShock instance. If you host your own instance, replace them with your own or
# leave PUBLIC_SECURITY_CONTACT empty to disable the file.
# PUBLIC_SECURITY_EXPIRES must be renewed before it passes (keep it less than a year ahead).
PUBLIC_SECURITY_CONTACT="mailto:security@openshock.org,https://github.com/OpenShock/.github/blob/main/SECURITY.md#reporting-a-vulnerability"
PUBLIC_SECURITY_EXPIRES=2027-10-31T00:00:00Z
PUBLIC_SECURITY_POLICY_URL=https://github.com/OpenShock/.github/blob/main/SECURITY.md
PUBLIC_SECURITY_ACKNOWLEDGMENTS_URL=https://github.com/OpenShock/.github/blob/main/SECURITY-ACKNOWLEDGMENTS.md

# Optional: full URL to the external Hangfire dashboard.
# When set, an admin-only "Hangfire" link to it appears in the sidebar.
# Leave unset (or empty) on deployments without a Hangfire dashboard to hide the link.
PUBLIC_HANGFIRE_URL=https://cron.openshock.app/hangfire

# Server-side only (Node adapter). When set to `true`, disables TLS certificate
# validation for the server's own outgoing requests, allowing SSR/API calls to a
# backend that uses a self-signed or otherwise untrusted certificate. INSECURE —
# only use with a trusted self-signed backend in development or on a self-hosted
# / isolated network. Leave unset (or `false`) in production. Read at runtime, so
# it can be provided as a container/process env var without rebuilding.
PRIVATE_BACKEND_TLS_INSECURE=false

# SigNoz / OpenTelemetry browser log shipping. Disabled by default; only the production
# deployment opts in (see .env.production). The endpoint is also only reachable via CORS/CSP
# from *.openshock.app.
PUBLIC_SIGNOZ_LOGS_ENABLED=false
PUBLIC_SIGNOZ_LOGS_URL=https://signoz.openshock.app/v1/logs
# OTLP traces endpoint (API-call tracing). Defaults to the logs collector origin + /v1/traces.
PUBLIC_SIGNOZ_TRACES_URL=https://signoz.openshock.app/v1/traces
# Propagate W3C trace context (traceparent/tracestate) to the backend API for distributed tracing.
# Requires the backend CORS config to allow those request headers, so off by default.
PUBLIC_SIGNOZ_TRACE_PROPAGATION=false
# Resource attributes attached to every shipped log/trace. `deployment.environment` is broken out
# for convenience; defaults to the build mode (development/production) when left empty.
PUBLIC_SIGNOZ_DEPLOYMENT_ENVIRONMENT=
# Extra OTel resource attributes, comma-separated key=value pairs (same format as the standard
# OTEL_RESOURCE_ATTRIBUTES env var). Example: deployment.region=eu,team=frontend
PUBLIC_SIGNOZ_RESOURCE_ATTRIBUTES=