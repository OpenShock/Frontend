{
	"name": "frontend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "cross-env BUILD_ENV=production vite build",
		"preview": "cross-env BUILD_ENV=production vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && pnpm run i18n:compile && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && pnpm run i18n:compile && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:unit": "vitest",
		"regen-api": "node scripts/regenerate-api.js",
		"i18n:compile": "paraglide-js compile --silent",
		"check:problem-types": "node scripts/check-problem-types.js --strict"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "latest",
		"@hey-api/openapi-ts": "^0.99.0",
		"@inlang/paraglide-js": "^3.2.0",
		"@inlang/paraglide-js-svelte": "^1.0.5",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@microsoft/signalr": "^10.0.11",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-table": "^9.3.1",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.6.6",
		"@types/semver": "^7.8.0",
		"@types/w3c-web-serial": "^1.0.9",
		"@typescript/native": "npm:typescript@~7.0.2",
		"bits-ui": "2.20.2",
		"boxen": "^9.0.0",
		"chalk": "^6.0.1",
		"clsx": "^2.1.1",
		"cross-env": "^10.1.0",
		"d3-scale": "^4.0.3",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-svelte": "^3.23.1",
		"esptool-js": "0.7.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"layerchart": "^2.9.1",
		"prettier": "~3.9.10",
		"prettier-plugin-organize-imports": "~4.3.0",
		"prettier-plugin-svelte": "~4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rollup-plugin-license": "^3.7.1",
		"semver": "^7.8.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"ua-parser-js": "2.0.10",
		"vaul-svelte": "1.0.0-next.7",
		"vite-plugin-devtools-json": "^1.1.2",
		"vite-plugin-mkcert": "^2.1.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.158.0"
	},
	"dependencies": {
		"@openshock/svelte-core": "workspace:*",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/context-async-hooks": "^3.1.0",
		"@opentelemetry/core": "^3.1.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.301.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
		"@opentelemetry/instrumentation": "^0.301.0",
		"@opentelemetry/instrumentation-fetch": "^0.301.0",
		"@opentelemetry/resources": "^3.1.0",
		"@opentelemetry/sdk-logs": "^3.1.0",
		"@opentelemetry/sdk-trace": "^3.1.0",
		"temporal-polyfill": "^1.0.6",
		"vite": "^8.3.5"
	},
	"engines": {
		"node": "^26",
		"pnpm": ">=12"
	},
	"browserslist": [
		"defaults and fully supports es6-module"
	],
	"packageManager": "pnpm@12.15.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
