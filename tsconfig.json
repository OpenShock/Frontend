{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "es2025",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    // svelte-check resolves `.svelte` imports itself and only understands tsconfig
    // `paths`, not package.json `imports`. Mirror the `#lib` subpaths here so
    // components imported through them keep their prop types.
    "paths": {
      "#lib": ["./src/lib/index.ts"],
      "#lib/*": ["./src/lib/*"]
    }
  },
  // `sv migrate` narrowed this to `src`; keep the config and plugin sources that
  // the pre-migration setup type-checked as well.
  "include": ["src", "e2e", "vite-plugins", "vite.config.ts", "playwright.config.ts"]
}
